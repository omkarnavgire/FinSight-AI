# ---- Database ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finsight_dev
DB_USERNAME=finsight_user
DB_PASSWORD=changeme

# ---- JWT ----
JWT_SECRET=replace-with-at-least-64-random-hex-characters
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# ---- Cookie ----
# Set to false for local HTTP dev; must be true in production
COOKIE_SECURE=false
# Number of trusted reverse-proxy hops (0 = no proxy; 1 = behind one load-balancer)
TRUSTED_PROXY_COUNT=0

# ---- Server ----
SERVER_PORT=8080

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173
