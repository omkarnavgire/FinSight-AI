# ---- Java / Maven ----
target/
*.class
*.jar
*.war
*.ear
*.nar
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/wrapper/maven-wrapper.jar
hs_err_pid*
replay_pid*

# ---- Spring Boot ----
# Profile YMLs are committed; they contain no secrets (secrets come from env vars).
# Do NOT add application-*.yml here — those files must be version-controlled.
# Only ignore a local override file:
application-local.yml

# ---- Environment / secrets ----
.env
.env.local
.env.production
*.secret

